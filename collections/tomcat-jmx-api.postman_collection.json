              "content": "Provides HTTP-based access to JMX MBeans. Supports query, get, set, and invoke operations on server management beans.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "jmxproxy",
                ""
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "qry",
                  "value": "<string>",
                  "description": "JMX query expression (e.g., *:type=RequestProcessor,*)"
                },
                {
                  "disabled": false,
                  "key": "get",
                  "value": "<string>",
                  "description": "MBean name to get attribute from"
                },
                {
                  "disabled": false,
                  "key": "att",
                  "value": "<string>",
                  "description": "Attribute name to get or set"
                },
                {
                  "disabled": false,
                  "key": "key",
                  "value": "<string>",
                  "description": "Key within a CompositeData attribute"
                },
                {
                  "disabled": false,
                  "key": "set",
                  "value": "<string>",
                  "description": "MBean name for attribute setting"
                },
                {
                  "disabled": false,
                  "key": "val",
                  "value": "<string>",
                  "description": "New attribute value"
                },
                {
                  "disabled": false,
                  "key": "invoke",
                  "value": "<string>",
                  "description": "MBean name for method invocation"
                },
                {
                  "disabled": false,
                  "key": "op",
