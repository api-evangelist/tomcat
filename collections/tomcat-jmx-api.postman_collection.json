                },
                {
                  "disabled": false,
                  "key": "ps",
                  "value": "<string>",
                  "description": "Parameters for method invocation"
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "text/plain"
              }
            ],
            "method": "GET",
            "auth": null
